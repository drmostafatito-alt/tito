# Copy to .dev.vars (gitignored) and fill for local development.
# Production secrets are set with `wrangler secret put` — never committed.

# Pepper mixed into session-token hashing (any long random string)
SESSION_PEPPER=dev-only-pepper-change-me

# PBKDF2 iterations (see docs/SECURITY.md §2 — Workers free-plan CPU tradeoff; raise on paid plan)
AUTH_PBKDF2_ITERATIONS=100000

# Seed / bootstrap: super admin email. LOCAL DEV ONLY — never a production
# identity. Production uses wrangler secret / env ADMIN_BOOTSTRAP_EMAIL
# (scripts/bootstrap-admin.mjs --remote refuses @educore.local).
ADMIN_BOOTSTRAP_EMAIL=admin@educore.local

# Environment: development | test | preview | production. UNKNOWN/MISSING is
# treated as production-safe (fail-closed). Set development only for local work.
ENVIRONMENT=development

# Canonical app URL. Production MUST be an HTTPS origin with no path/query.
# Local development falls back to the incoming Wrangler preview origin.
APP_ORIGIN=http://127.0.0.1:5173

# Transactional email. Leave blank/noop locally. Production must use `resend`
# with a server-only API key (never VITE_/PUBLIC_) and a sender on a domain
# verified by the owner in Resend. onboarding@resend.dev is manual development
# only and can send only to the Resend account owner's address.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=

# Phase 2 — HMAC secret for short-lived private-file signed URLs
FILE_URL_SECRET=change-me-long-random

# Phase 2 — HMAC secret for mock video provider playback tokens
MOCK_VIDEO_SECRET=change-me-long-random

# Phase 2 — Mux adapter credentials (empty = not configured; video settings decide the active provider)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
# Non-secret ID of the Mux playback restriction configured for the production origin.
MUX_PLAYBACK_RESTRICTION_ID=

# Phase 6 — HMAC secret for the MOCK payment gateway webhooks (TEST-ONLY; do NOT set in production)
MOCK_PAYMENTS_SECRET=change-me-long-random
